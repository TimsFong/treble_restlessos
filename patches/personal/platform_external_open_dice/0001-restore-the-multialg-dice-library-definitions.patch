From 567b9d8c6ee4e55e790502b03473535f55a799e9 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Mon, 28 Sep 2026 22:39:10 +0100
Subject: [PATCH] restore the multialg dice library definitions

---
 Android.bp | 62 ++++++++++++++++++++++++++++++++++++++++++++++++++++++
 1 file changed, 62 insertions(+)

diff --git a/Android.bp b/Android.bp
index 37745e4..973d161 100644
--- a/Android.bp
+++ b/Android.bp
@@ -252,3 +252,65 @@ rust_test {
     clippy_lints: "none",
     lints: "none",
 }
+
+// multialg dice libraries, restored from the android 16 definitions. the
+// multialg sources and headers are still shipped in this tree but the
+// module definitions were dropped upstream, and the gsi vendored multialg
+// rust bindings (device/phh/treble/gsi_stubs/dice) link against them.
+
+cc_library_headers {
+    name: "libopen_dice_boringssl_multialg_headers",
+    host_supported: true,
+    vendor_available: true,
+    export_include_dirs: [
+        "include/dice/config/boringssl_multialg",
+        "include/dice/config/android",
+    ],
+}
+
+cc_library_static {
+    name: "libopen_dice_cbor_multialg",
+    host_supported: true,
+    vendor_available: true,
+    srcs: [
+        "src/boringssl_hash_kdf_ops.c",
+        "src/boringssl_ecdsa_utils.c",
+        "src/boringssl_multialg_ops.c",
+        "src/cbor_cert_op.c",
+        "src/cbor_writer.c",
+        "src/clear_memory.c",
+        "src/dice.c",
+        "src/utils.c",
+    ],
+    header_libs: [
+        "libopen_dice_boringssl_multialg_headers",
+        "libopen_dice_headers",
+    ],
+    export_header_lib_headers: [
+        "libopen_dice_boringssl_multialg_headers",
+        "libopen_dice_headers",
+    ],
+    shared_libs: ["libcrypto"],
+
+    // this library gets linked into a rust rlib; disable lto until
+    // cross-language lto is supported
+    lto: {
+        never: true,
+    },
+}
+
+cc_library_static {
+    name: "libopen_dice_android_multialg",
+    host_supported: true,
+    vendor_available: true,
+    srcs: ["src/android.c"],
+    static_libs: ["libopen_dice_cbor_multialg"],
+    export_static_lib_headers: ["libopen_dice_cbor_multialg"],
+    shared_libs: ["libcrypto"],
+
+    // this library gets linked into a rust rlib; disable lto until
+    // cross-language lto is supported
+    lto: {
+        never: true,
+    },
+}
-- 
