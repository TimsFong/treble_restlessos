From 856c20d0f309a28f78900a9050249830edd1d912 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Mon, 28 Sep 2026 08:40:32 +0100
Subject: [PATCH 1/2] gsi: build system adjustments

build system adjustments for gsi boots: skip the vendor
/my_manifest mount that gsis cannot satisfy, and disable the
cuttlefish-only aosp_shared_system_image module that leaks into
soong analysis on non-cuttlefish products.
---
 target/product/generic/Android.bp     | 1 +
 target/product/gsi/gsi_skip_mount.cfg | 3 +++
 2 files changed, 4 insertions(+)

diff --git a/target/product/generic/Android.bp b/target/product/generic/Android.bp
index edef3a8..12de408 100644
--- a/target/product/generic/Android.bp
+++ b/target/product/generic/Android.bp
@@ -1174,6 +1174,7 @@ system_image_defaults {
 android_system_image {
     name: "aosp_shared_system_image",
     defaults: ["system_image_defaults"],
+    enabled: false,
     dirs: android_rootdirs,
     symlinks: android_symlinks,
     type: "erofs",
diff --git a/target/product/gsi/gsi_skip_mount.cfg b/target/product/gsi/gsi_skip_mount.cfg
index 28f4349..612c3bc 100644
--- a/target/product/gsi/gsi_skip_mount.cfg
+++ b/target/product/gsi/gsi_skip_mount.cfg
@@ -7,3 +7,6 @@
 /product/*
 /system_ext/*
 /system/*
+# Skip OPlus "my_manifest" mountpoints.
+/mnt/vendor/my_manifest
+/my_manifest
-- 
2.55.0

