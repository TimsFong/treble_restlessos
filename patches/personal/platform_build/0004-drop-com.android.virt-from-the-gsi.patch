From 43e74aa473d750b17427d1636fd8ac5dd34fc360 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Mon, 28 Sep 2026 01:12:18 +0100
Subject: [PATCH 4/5] drop com.android.virt from the gsi

the AVF/virtualization apex serves pKVM-based VM workloads (crosvm,
virtualizationservice, microdroid). none of that is reachable on the
target fleet: vendor kernels are 4.4-5.4 with no pKVM, and nothing in
the boot path consumes the apex. it still cost system space and, as
an erofs payload, produced a per-boot failed activation plus a
pointless fallback retry on kernels without the erofs driver.

remove the apex install and its framework-virtualization boot jar
entry. the LLPVM-gated service-virtualization system_server jar entry
is inactive on aosp_current (cp2a leaves the flag at its false
default). the watchdog reference is in NATIVE_STACKS_OF_INTEREST
(stack dumps only), and the terminal-app config entries are runtime
package-name matches, so both tolerate the module being absent.
---
 target/product/base_system.mk        | 1 -
 target/product/default_art_config.mk | 1 -
 2 files changed, 2 deletions(-)

diff --git a/target/product/base_system.mk b/target/product/base_system.mk
index cacffe5..921ad80 100644
--- a/target/product/base_system.mk
+++ b/target/product/base_system.mk
@@ -86,7 +86,6 @@ PRODUCT_PACKAGES += \
     $(RELEASE_PACKAGE_TZDATA_MODULE) \
     com.android.uprobestats \
     com.android.uwb \
-    com.android.virt \
     com.android.wifi \
     ContactsProvider \
     content \
diff --git a/target/product/default_art_config.mk b/target/product/default_art_config.mk
index 7689dd0..4df5c26 100644
--- a/target/product/default_art_config.mk
+++ b/target/product/default_art_config.mk
@@ -89,7 +89,6 @@ PRODUCT_APEX_BOOT_JARS := \
     com.android.tethering:framework-connectivity-b \
     com.android.tethering:framework-tethering \
     com.android.uwb:framework-uwb \
-    com.android.virt:framework-virtualization \
     com.android.wifi:framework-wifi \
 
 # When we release ondeviceintelligence in NeuralNetworks module
