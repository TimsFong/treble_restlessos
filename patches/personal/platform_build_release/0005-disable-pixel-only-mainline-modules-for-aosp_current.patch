From e1a08e40897415c4d0be251b3e1b54f90a3ec0ec Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Mon, 28 Sep 2026 04:16:03 +0100
Subject: [PATCH 5/5] disable pixel-only mainline modules for aosp_current

npumanager (tensor NPU), the ranging stack (uwb-tied), aiseal and the
anomaly detector serve hardware or service stacks the target fleet
does not have. flip the cp2a flag values off; all product and
classpath wiring for these modules is flag-gated upstream, so the
apexes, boot jars and services drop out of the image cleanly.
---
 flag_values/cp2a/RELEASE_AISEAL_FRAMEWORK.textproto  | 2 +-
 flag_values/cp2a/RELEASE_ANOMALY_DETECTOR.textproto  | 2 +-
 flag_values/cp2a/RELEASE_NPUMANAGER_MODULE.textproto | 2 +-
 flag_values/cp2a/RELEASE_RANGING_STACK.textproto     | 4 ++++
 4 files changed, 7 insertions(+), 3 deletions(-)
 create mode 100644 flag_values/cp2a/RELEASE_RANGING_STACK.textproto

diff --git a/flag_values/cp2a/RELEASE_AISEAL_FRAMEWORK.textproto b/flag_values/cp2a/RELEASE_AISEAL_FRAMEWORK.textproto
index 5a8ac64..636f8c9 100644
--- a/flag_values/cp2a/RELEASE_AISEAL_FRAMEWORK.textproto
+++ b/flag_values/cp2a/RELEASE_AISEAL_FRAMEWORK.textproto
@@ -1,4 +1,4 @@
 name: "RELEASE_AISEAL_FRAMEWORK"
 value {
-  bool_value: true
+  bool_value: false
 }
diff --git a/flag_values/cp2a/RELEASE_ANOMALY_DETECTOR.textproto b/flag_values/cp2a/RELEASE_ANOMALY_DETECTOR.textproto
index 6bf804c..2a89c9c 100644
--- a/flag_values/cp2a/RELEASE_ANOMALY_DETECTOR.textproto
+++ b/flag_values/cp2a/RELEASE_ANOMALY_DETECTOR.textproto
@@ -1,4 +1,4 @@
 name: "RELEASE_ANOMALY_DETECTOR"
 value {
-  bool_value: true
+  bool_value: false
 }
diff --git a/flag_values/cp2a/RELEASE_NPUMANAGER_MODULE.textproto b/flag_values/cp2a/RELEASE_NPUMANAGER_MODULE.textproto
index 1b9f838..faa8452 100644
--- a/flag_values/cp2a/RELEASE_NPUMANAGER_MODULE.textproto
+++ b/flag_values/cp2a/RELEASE_NPUMANAGER_MODULE.textproto
@@ -1,4 +1,4 @@
 name: "RELEASE_NPUMANAGER_MODULE"
 value {
-  bool_value: true
+  bool_value: false
 }
diff --git a/flag_values/cp2a/RELEASE_RANGING_STACK.textproto b/flag_values/cp2a/RELEASE_RANGING_STACK.textproto
new file mode 100644
index 0000000..0a68186
--- /dev/null
+++ b/flag_values/cp2a/RELEASE_RANGING_STACK.textproto
@@ -0,0 +1,4 @@
+name: "RELEASE_RANGING_STACK"
+value {
+  bool_value: false
+}
