From f6574e647de7b5eb23c76ca84c122da0ad595f00 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Sat, 26 Sep 2026 21:15:19 +0100
Subject: [PATCH 3/4] device/phh/treble: ship prebuilt bootanimation zip

Replace the build-time-zipped source frames with a prebuilt
bootanimation.zip installed via PRODUCT_COPY_FILES to
/system/media/bootanimation.zip.

The archive entries are stored uncompressed: BootAnimation only
accepts stored png entries and skips deflated ones outright. The
trebledroid dynamic-resize patch scales the animation to the device
screen, so a single 640x640 source set covers all gsi targets.
---
 base.mk           |   7 +++++++
 bootanimation.zip | Bin 0 -> 14844328 bytes
 2 files changed, 7 insertions(+)
 create mode 100644 bootanimation.zip

diff --git a/base.mk b/base.mk
index 6cf6e95..8fff6a6 100644
--- a/base.mk
+++ b/base.mk
@@ -228,6 +228,13 @@ PRODUCT_COPY_FILES += \
 
 PRODUCT_PACKAGES += phh-ota
 
+# prebuilt bootanimation; installs to /system/media/bootanimation.zip, the
+# default path the bootanimation binary reads. entries must stay stored
+# (uncompressed) -- BootAnimation skips deflated frame entries entirely.
+# the trebledroid dynamic-resize patch scales it to the device screen.
+PRODUCT_COPY_FILES += \
+    device/phh/treble/bootanimation.zip:system/media/bootanimation.zip
+
 PRODUCT_PACKAGES += \
     xiaomi-touch
 
diff --git a/bootanimation.zip b/bootanimation.zip
new file mode 100644
index 0000000000000000000000000000000000000000..72fea528b0843875aeccb22ab7dd814f164f3bdb
GIT binary patch
literal 14844328
