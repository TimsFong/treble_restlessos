diff --git a/base.mk b/base.mk
index 8fff6a6..99173ae 100644
--- a/base.mk
+++ b/base.mk
@@ -235,6 +235,22 @@ PRODUCT_PACKAGES += phh-ota
 PRODUCT_COPY_FILES += \
     device/phh/treble/bootanimation.zip:system/media/bootanimation.zip
 
+# restlessos default wallpapers, art by ziednaga (cc by-nc 4.0); wired into
+# the wallpaper service via ro.config.wallpaper / ro.config.lock_wallpaper
+PRODUCT_COPY_FILES += \
+    device/phh/treble/wallpapers/LICENSE:system/etc/wallpaper/LICENSE \
+    device/phh/treble/wallpapers/RestlessStars-Homescreen-Dark.webp:system/etc/wallpaper/RestlessStars-Homescreen-Dark.webp \
+    device/phh/treble/wallpapers/RestlessStars-Lock-Dark.webp:system/etc/wallpaper/RestlessStars-Lock-Dark.webp
+
+PRODUCT_SYSTEM_PROPERTIES += \
+    ro.config.wallpaper=/system/etc/wallpaper/RestlessStars-Homescreen-Dark.webp \
+    ro.config.lock_wallpaper=/system/etc/wallpaper/RestlessStars-Lock-Dark.webp
+
+# wallpaper picker and additional on-device wallpaper options (rom 0004)
+PRODUCT_PACKAGES += \
+    WallpaperPicker2 \
+    RestlessWallpapers
+
 PRODUCT_PACKAGES += \
     xiaomi-touch
 
diff --git a/partner-wallpapers/Android.bp b/partner-wallpapers/Android.bp
new file mode 100644
index 0000000..73831de
--- /dev/null
+++ b/partner-wallpapers/Android.bp
@@ -0,0 +1,10 @@
+package = "com.restlessos.partner.wallpapers"
+
+android_app {
+    name: "RestlessWallpapers",
+    srcs: ["src/**/*.java"],
+    resource_dirs: ["res"],
+    manifest: "AndroidManifest.xml",
+    sdk_version: "current",
+    export_package_resources: true,
+}
diff --git a/partner-wallpapers/AndroidManifest.xml b/partner-wallpapers/AndroidManifest.xml
new file mode 100644
index 0000000..364d93b
--- /dev/null
+++ b/partner-wallpapers/AndroidManifest.xml
@@ -0,0 +1,12 @@
+<?xml version="1.0" encoding="utf-8"?>
+<manifest xmlns:android="http://schemas.android.com/apk/res/android"
+    package="com.restlessos.partner.wallpapers">
+
+    <application>
+        <receiver android:name=".PartnerReceiver" android:exported="true">
+            <intent-filter>
+                <action android:name="com.android.launcher3.action.PARTNER_CUSTOMIZATION" />
+            </intent-filter>
+        </receiver>
+    </application>
+</manifest>
