new file mode 100644
index 0000000..f0c2ef4
--- /dev/null
+++ b/partner-wallpapers/res/values/arrays.xml
@@ -0,0 +1,11 @@
+<?xml version="1.0" encoding="utf-8"?>
+<resources>
+    <!-- additional on-device wallpaper options in WallpaperPicker2; each name
+         must have a matching <name>_small thumbnail drawable -->
+    <string-array name="partner_wallpapers" translatable="false">
+        <item>restlessstars_light</item>
+        <item>restlessstars_homescreen_light</item>
+        <item>restlessstars_lockscreen_light</item>
+        <item>restlessstars_lockscreen_dark</item>
+    </string-array>
+</resources>
diff --git a/partner-wallpapers/src/com/restlessos/partner/wallpapers/PartnerReceiver.java b/partner-wallpapers/src/com/restlessos/partner/wallpapers/PartnerReceiver.java
new file mode 100644
index 0000000..a83a8eb
--- /dev/null
+++ b/partner-wallpapers/src/com/restlessos/partner/wallpapers/PartnerReceiver.java
@@ -0,0 +1,17 @@
+package com.restlessos.partner.wallpapers;
+
+import android.content.BroadcastReceiver;
+import android.content.Context;
+import android.content.Intent;
+
+/**
+ * Marker receiver discovered by WallpaperPicker2 via the
+ * com.android.launcher3.action.PARTNER_CUSTOMIZATION broadcast. its presence
+ * makes the picker load this apk's resources as the partner customization
+ * package; no logic needed here.
+ */
+public class PartnerReceiver extends BroadcastReceiver {
+    @Override
+    public void onReceive(Context context, Intent intent) {
+    }
+}
