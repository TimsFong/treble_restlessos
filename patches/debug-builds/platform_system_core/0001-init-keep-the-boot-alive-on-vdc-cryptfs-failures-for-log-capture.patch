From 82b728777e41b3cf99a425c289fa9dfa2e3f4600 Mon Sep 17 00:00:00 2001
From: "Christopher A. Williamson" <contact@chrisaw.io>
Date: Wed, 30 Sep 2026 22:48:21 +0100
Subject: [PATCH] init: keep the boot alive on vdc cryptfs failures for log
 capture

rebooting into recovery on enablefilecrypto/init_user0 failure hides
the actual error and prompts a data wipe on gsi devices. suppress the
recovery reboot, log the failure and expose the reason via
debug.init.vdc_failure_reason so the degraded boot can be diagnosed
over adb.
---
 init/builtins.cpp | 27 ++++++++-------------------
 1 file changed, 8 insertions(+), 19 deletions(-)

diff --git a/init/builtins.cpp b/init/builtins.cpp
index fb3da9a8f..b934969f3 100644
--- a/init/builtins.cpp
+++ b/init/builtins.cpp
@@ -1159,25 +1159,14 @@ static Result<void> ExecVdcRebootOnFailure(const std::string& vdc_arg) {
     auto reboot_reason = vdc_arg + "_failed";
 
     auto reboot = [reboot_reason](const std::string& message) {
-        // TODO (b/122850122): support this in gsi
-        if (IsFbeEnabled() && !android::gsi::IsGsiRunning()) {
-            std::string wipe_option = "--prompt_and_wipe_data";
-            // TODO (b/456474148) Change this code to run as a vendor specific extension in
-            // recovery, flag will change to --wipe_data_with_tpm_check
-            if (IsDeviceDesktop() && reboot_reason == "init_user0_failed" && CheckIfTpmCleared()) {
-                wipe_option = "--wipe_data";
-            }
-            // If vdc has failed to mount the initial userdata partition and the gsc keys
-            // have been changed, we can perform a factory data reset on behalf of the user
-            // automatically.
-            LOG(ERROR) << message << ": Rebooting into recovery, reason: " << reboot_reason;
-            if (auto result = reboot_into_recovery({wipe_option, "--reason="s + reboot_reason});
-                !result.ok()) {
-                LOG(FATAL) << "Could not reboot into recovery: " << result.error();
-            }
-        } else {
-            LOG(ERROR) << "Failure (reboot suppressed): " << reboot_reason;
-        }
+        // [gsi debug] keep the boot alive when vdc cryptfs steps fail so the
+        // failure can be diagnosed over adb: log the reason, stash it in a
+        // retrievable property and continue instead of rebooting into
+        // recovery (which also avoids the wipe-data prompt on gsi devices).
+        // the subsequent boot may be degraded; that is the point.
+        LOG(ERROR) << message << ": reboot into recovery suppressed for log capture, reason: "
+                   << reboot_reason;
+        android::base::SetProperty("debug.init.vdc_failure_reason", reboot_reason);
     };
 
     std::vector<std::string> args = {"exec", "/system/bin/vdc", "--wait", "cryptfs", vdc_arg};
-- 
